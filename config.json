{
  "inputs": {
    "clean_map": "clean_map.jpg",
    "track_map": "track_map.jpg",
    "auto_swap": true
  },
  "output": {
    "video_path": "output/output_animation.mp4",
    "fps": 30,
    "codec": "avc1",
    "resolution": null,
    "debug_dir": "debug",
    "aspect": [
      16,
      9
    ],
    "quality": "max"
  },
  "mode": "reveal",
  "timing": {
    "first_marker_delay_sec": 1.0,
    "initial_delay_sec": 1.0,
    "track_duration_sec": 4.0,
    "pause_on_waypoints": true,
    "waypoint_pause_duration_sec": 1.2,
    "final_delay_sec": 2.0
  },
  "circle_detection": {
    "min_circle_radius_px": 8.5
  },
  "reveal_settings": {
    "line_brush_radius": null,
    "line_brush_margin_px": 2,
    "waypoint_brush_radius": null
  },
  "redraw_settings": {
    "line_color_bgr": [
      255,
      122,
      0
    ],
    "line_thickness": 10,
    "marker_color_bgr": [
      255,
      122,
      0
    ],
    "marker_text_color_bgr": [
      255,
      255,
      255
    ],
    "marker_radius": 16,
    "marker_font_scale": 0.55,
    "marker_font_thickness": 2,
    "auto_scale_drawing": true,
    "marker_font_path": null,
    "marker_font_index": 0,
    "marker_font_size_px": 16,
    "marker_outline_px": 2,
    "marker_outline_color_bgr": [
      255,
      255,
      255
    ]
  },
  "hsv_blue_range": {
    "lower": [
      90,
      50,
      50
    ],
    "upper": [
      130,
      255,
      255
    ]
  },
  "logging": {
    "file": "logs/animate_map.log",
    "level": "INFO"
  },
  "path_settings": {
    "spur_length_px": 25,
    "smooth_sigma": 1.2,
    "diff_threshold": 15,
    "max_mismatch_fraction": 0.01
  }
}
